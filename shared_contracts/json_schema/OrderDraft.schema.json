{
  "$defs": {
    "Alert": {
      "properties": {
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/AlertType"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Id"
        },
        "message_fr": {
          "title": "Message Fr",
          "type": "string"
        },
        "suggested_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Action"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "alert_id",
        "type",
        "severity",
        "message_fr"
      ],
      "title": "Alert",
      "type": "object"
    },
    "AlertType": {
      "enum": [
        "UNKNOWN_SKU",
        "AMBIGUOUS_SKU",
        "OUT_OF_STOCK",
        "LOW_STOCK",
        "LOW_CONFIDENCE",
        "UNIT_MISMATCH",
        "WEIGHT_ESTIMATE",
        "CONDITIONAL_LINE",
        "QUANTITY_ANOMALY",
        "PRICE_REQUEST",
        "HISTORY_USED",
        "UPSELL"
      ],
      "title": "AlertType",
      "type": "string"
    },
    "Candidate": {
      "properties": {
        "sku": {
          "title": "Sku",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "sku",
        "label",
        "score"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Latency": {
      "properties": {
        "stt_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stt Ms"
        },
        "extract_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extract Ms"
        },
        "total_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Ms"
        }
      },
      "title": "Latency",
      "type": "object"
    },
    "LineSource": {
      "enum": [
        "voice",
        "history",
        "operator"
      ],
      "title": "LineSource",
      "type": "string"
    },
    "OrderLine": {
      "properties": {
        "line_id": {
          "title": "Line Id",
          "type": "string"
        },
        "raw_mention": {
          "title": "Raw Mention",
          "type": "string"
        },
        "sku": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku"
        },
        "product_label": {
          "title": "Product Label",
          "type": "string"
        },
        "spoken_quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spoken Quantity"
        },
        "spoken_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "sell_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quantity_is_estimate": {
          "default": false,
          "title": "Quantity Is Estimate",
          "type": "boolean"
        },
        "unit_price_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price Eur"
        },
        "line_total_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Total Eur"
        },
        "conditional": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conditional"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "match_score": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Match Score",
          "type": "number"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "stock_status": {
          "$ref": "#/$defs/StockStatus",
          "default": "unknown"
        },
        "substitution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Substitution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/LineSource",
          "default": "voice"
        },
        "operator_override": {
          "default": false,
          "title": "Operator Override",
          "type": "boolean"
        }
      },
      "required": [
        "line_id",
        "raw_mention",
        "product_label",
        "confidence"
      ],
      "title": "OrderLine",
      "type": "object"
    },
    "OrderStatus": {
      "enum": [
        "listening",
        "draft",
        "needs_review",
        "confirmed",
        "injected"
      ],
      "title": "OrderStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "warn",
        "block"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StockStatus": {
      "enum": [
        "ok",
        "low",
        "out",
        "unknown"
      ],
      "title": "StockStatus",
      "type": "string"
    },
    "Substitution": {
      "properties": {
        "sku": {
          "title": "Sku",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "sku",
        "label",
        "reason"
      ],
      "title": "Substitution",
      "type": "object"
    },
    "Unit": {
      "description": "Spoken or sell units. Keep French trade vocabulary.",
      "enum": [
        "kg",
        "g",
        "piece",
        "botte",
        "barquette",
        "plateau",
        "colis",
        "cagette",
        "caisse",
        "sac",
        "filet",
        "palette",
        "litre",
        "bidon"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "properties": {
    "contract_version": {
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
    "version": {
      "default": 0,
      "title": "Version",
      "type": "integer"
    },
    "customer_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Customer Id"
    },
    "customer_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Customer Name"
    },
    "status": {
      "$ref": "#/$defs/OrderStatus",
      "default": "listening"
    },
    "delivery_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivery Date"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/OrderLine"
      },
      "title": "Lines",
      "type": "array"
    },
    "alerts": {
      "items": {
        "$ref": "#/$defs/Alert"
      },
      "title": "Alerts",
      "type": "array"
    },
    "global_confidence": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Global Confidence",
      "type": "number"
    },
    "total_eur": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Eur"
    },
    "readback_fr": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Readback Fr"
    },
    "extractor": {
      "default": "rules",
      "enum": [
        "llm",
        "rules"
      ],
      "title": "Extractor",
      "type": "string"
    },
    "latency": {
      "$ref": "#/$defs/Latency"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "call_id"
  ],
  "title": "OrderDraft",
  "type": "object"
}